function Engine.IsAttacked(st, target, bySide)
    local b = st.b; local tf, tr = fileOf(target), rankOf(target)
    local pr = bySide == "w" and (tr + 1) or (tr - 1)
    if pr >= 0 and pr < 8 then
        for _, df in ipairs({ -1, 1 }) do
            local nf = tf + df
            if nf >= 0 and nf < 8 and b[sq(nf, pr)] == (bySide == "w" and "P" or "p") then return true end
        end
    end
    for _, d in ipairs(KNIGHT_D) do
        local nf, nr = tf + d[1], tr + d[2]
        if nf >= 0 and nf < 8 and nr >= 0 and nr < 8 and b[sq(nf, nr)] == (bySide == "w" and "N" or "n") then return true end
    end
    for _, d in ipairs(KING_D) do
        local nf, nr = tf + d[1], tr + d[2]
        if nf >= 0 and nf < 8 and nr >= 0 and nr < 8 and b[sq(nf, nr)] == (bySide == "w" and "K" or "k") then return true end
    end
    for _, d in ipairs(BISHOP_D) do
        local nf, nr = tf + d[1], tr + d[2]
        while nf >= 0 and nf < 8 and nr >= 0 and nr < 8 do
            local p = b[sq(nf, nr)]
            if p ~= "" then
                if colorOf(p) == bySide then local u = p:upper(); if u == "B" or u == "Q" then return true end end
                break
            end
            nf = nf + d[1]; nr = nr + d[2]
        end
    end
    for _, d in ipairs(ROOK_D) do
        local nf, nr = tf + d[1], tr + d[2]
        while nf >= 0 and nf < 8 and nr >= 0 and nr < 8 do
            local p = b[sq(nf, nr)]
            if p ~= "" then
                if colorOf(p) == bySide then local u = p:upper(); if u == "R" or u == "Q" then return true end end
                break
            end
            nf = nf + d[1]; nr = nr + d[2]
        end
    end
    return false
end

local function addMove(moves, from, to, captured, promo, flags)
