local function genPseudo(st, capturesOnly)
    local b = st.b; local side = st.side; local moves = {}
    for i = 0, 63 do
        local p = b[i]
        if p ~= "" and colorOf(p) == side then
            local u = p:upper(); local f, r = fileOf(i), rankOf(i)
            if u == "P" then
                local dir = side == "w" and -1 or 1
                local startRank = side == "w" and 6 or 1
                local promoRank = side == "w" and 0 or 7
                local oneR = r + dir
                if oneR >= 0 and oneR < 8 then
                    local one = sq(f, oneR)
                    if b[one] == "" then
                        if not capturesOnly then
                            if oneR == promoRank then
                                for _, pr in ipairs({ "Q", "R", "B", "N" }) do addMove(moves, i, one, "", side == "w" and pr or pr:lower(), "promo") end
                            else addMove(moves, i, one) end
                        end
                        if r == startRank then
                            local two = sq(f, r + 2 * dir)
                            if b[two] == "" then addMove(moves, i, two, "", "", "double") end
                        end
                    end
                    for _, df in ipairs({ -1, 1 }) do
                        local nf = f + df
                        if nf >= 0 and nf < 8 then
                            local t = sq(nf, oneR); local tp = b[t]
                            if tp ~= "" and colorOf(tp) ~= side then
                                if oneR == promoRank then
                                    for _, pr in ipairs({ "Q", "R", "B", "N" }) do addMove(moves, i, t, tp, side == "w" and pr or pr:lower(), "promo") end
                                else addMove(moves, i, t, tp) end
                            elseif t == st.ep and tp == "" then addMove(moves, i, t, side == "w" and "p" or "P", "", "ep") end
                        end
                    end
                end
            elseif u == "N" or u == "K" then
                for _, d in ipairs(u == "N" and KNIGHT_D or KING_D) do
                    local nf, nr = f + d[1], r + d[2]
                    if nf >= 0 and nf < 8 and nr >= 0 and nr < 8 then
                        local t = sq(nf, nr); local tp = b[t]
                        if tp == "" then if not capturesOnly then addMove(moves, i, t) end
                        elseif colorOf(tp) ~= side then addMove(moves, i, t, tp) end
                    end
                end
            end
            if u == "B" or u == "R" or u == "Q" then
                local dirs = {}
                if u == "B" or u == "Q" then for _, d in ipairs(BISHOP_D) do table.insert(dirs, d) end end
                if u == "R" or u == "Q" then for _, d in ipairs(ROOK_D) do table.insert(dirs, d) end end
                for _, d in ipairs(dirs) do
                    local nf, nr = f + d[1], r + d[2]
                    while nf >= 0 and nf < 8 and nr >= 0 and nr < 8 do
                        local t = sq(nf, nr); local tp = b[t]
                        if tp == "" then if not capturesOnly then addMove(moves, i, t) end
                        else
                            if colorOf(tp) ~= side then addMove(moves, i, t, tp) end
                            break
                        end
                        nf = nf + d[1]; nr = nr + d[2]
                    end
                end
            end
        end
    end
    if not capturesOnly then
        local b2 = st.b; local opp = enemySide(side)
        if side == "w" and b2[60] == "K" then
            if st.castling:find("K") and b2[61] == "" and b2[62] == "" and b2[63] == "R" and not Engine.IsAttacked(st, 60, opp) and not Engine.IsAttacked(st, 61, opp) and not Engine.IsAttacked(st, 62, opp) then addMove(moves, 60, 62, "", "", "castle") end
            if st.castling:find("Q") and b2[59] == "" and b2[58] == "" and b2[57] == "" and b2[56] == "R" and not Engine.IsAttacked(st, 60, opp) and not Engine.IsAttacked(st, 59, opp) and not Engine.IsAttacked(st, 58, opp) then addMove(moves, 60, 58, "", "", "castle") end
        elseif side == "b" and b2[4] == "k" then
            if st.castling:find("k") and b2[5] == "" and b2[6] == "" and b2[7] == "r" and not Engine.IsAttacked(st, 4, opp) and not Engine.IsAttacked(st, 5, opp) and not Engine.IsAttacked(st, 6, opp) then addMove(moves, 4, 6, "", "", "castle") end
            if st.castling:find("q") and b2[3] == "" and b2[2] == "" and b2[1] == "" and b2[0] == "r" and not Engine.IsAttacked(st, 4, opp) and not Engine.IsAttacked(st, 3, opp) and not Engine.IsAttacked(st, 2, opp) then addMove(moves, 4, 2, "", "", "castle") end
        end
    end
    return moves
end

function Engine.Make(st, m)
    local b = st.b; local undo = { captured = b[m.to], cf = -1, castling = st.castling, ep = st.ep, moved = b[m.from] }
    local p = b[m.from]
    if m.flags == "ep" then local capSq = m.to + (st.side == "w" and 8 or -8); undo.captured = b[capSq]; undo.cf = capSq; b[capSq] = "" end
    b[m.to] = m.promo ~= "" and m.promo or p; b[m.from] = ""
    if m.flags == "castle" then
        if m.to == 62 then b[61] = b[63]; b[63] = "" elseif m.to == 58 then b[59] = b[56]; b[56] = "" elseif m.to == 6 then b[5] = b[7]; b[7] = "" elseif m.to == 2 then b[3] = b[0]; b[0] = "" end
    end
    local c = st.castling
    if p == "K" then c = c:gsub("K", ""):gsub("Q", "") elseif p == "k" then c = c:gsub("k", ""):gsub("q", "") end
    if m.from == 56 or m.to == 56 then c = c:gsub("Q", "") end
    if m.from == 63 or m.to == 63 then c = c:gsub("K", "") end
    if m.from == 0 or m.to == 0 then c = c:gsub("q", "") end
    if m.from == 7 or m.to == 7 then c = c:gsub("k", "") end
    st.castling = c; st.ep = -1
    if m.flags == "double" then st.ep = m.from + (st.side == "w" and -8 or 8) end
    st.side = enemySide(st.side)
    return undo
end

function Engine.Unmake(st, m, undo)
    local b = st.b; st.side = enemySide(st.side); b[m.from] = undo.moved
    if undo.cf >= 0 then b[undo.cf] = undo.captured; b[m.to] = "" else b[m.to] = undo.captured end
    if m.flags == "castle" then
        if m.to == 62 then b[63] = b[61]; b[61] = "" elseif m.to == 58 then b[56] = b[59]; b[59] = "" elseif m.to == 6 then b[7] = b[5]; b[5] = "" elseif m.to == 2 then b[0] = b[3]; b[3] = "" end
    end
    st.castling = undo.castling; st.ep = undo.ep
end

local function findKing(st, side)
    local k = side == "w" and "K" or "k"
    for i = 0, 63 do if st.b[i] == k then return i end end
    return -1
end

function Engine.LegalMoves(st)
    local pseudo = genPseudo(st, false); local out = {}; local mySide = st.side
    for _, m in ipairs(pseudo) do
        local undo = Engine.Make(st, m)
        if not Engine.IsAttacked(st, findKing(st, mySide), st.side) then table.insert(out, m) end
        Engine.Unmake(st, m, undo)
    end
    return out
end

local function mirrorW(i) return (7 - math.floor(i / 8)) * 8 + (i % 8) end

local function evaluate(st)
    local score = 0; local b = st.b
    for i = 0, 63 do
        local p = b[i]
        if p ~= "" then
            local w = isWhitePiece(p); local u = p:upper(); local tbl = PST[u]
            local v = VALUES[u] + (tbl and tbl[w and mirrorW(i) or i] or 0)
            if w then score = score + v else score = score - v end
        end
    end
    return st.side == "w" and score or -score
end

local moveCounter = 0; local maxNodes = 0

local function quiesce(st, alpha, beta, qd)
    moveCounter = moveCounter + 1
    if moveCounter % 1000 == 0 then task.wait() end
    if moveCounter > maxNodes then return evaluate(st) end
    local stand = evaluate(st)
    if qd >= 5 or stand >= beta then return stand end
    if stand > alpha then alpha = stand end
    local moves = genPseudo(st, true)
    table.sort(moves, function(a, b2) return (a.captured ~= "" and VALUES[a.captured:upper()] or 0) > (b2.captured ~= "" and VALUES[b2.captured:upper()] or 0) end)
    local mySide = st.side
    for _, m in ipairs(moves) do
        local undo = Engine.Make(st, m); local ksq = findKing(st, mySide)
        if not Engine.IsAttacked(st, ksq, st.side) then
            local score = -quiesce(st, -beta, -alpha, qd + 1); Engine.Unmake(st, m, undo)
            if score >= beta then return beta end
            if score > alpha then alpha = score end
        else Engine.Unmake(st, m, undo) end
    end
    return alpha
end

local function search(st, depth, alpha, beta, ply)
    moveCounter = moveCounter + 1
    if moveCounter % 1000 == 0 then task.wait() end
    if moveCounter > maxNodes then return evaluate(st) end
    if depth <= 0 then return quiesce(st, alpha, beta, 0) end
    local moves = genPseudo(st, false)
    table.sort(moves, function(a, b2) return ((a.captured ~= "" and VALUES[a.captured:upper()] or 0) * 10 + (a.promo ~= "" and 900 or 0)) > ((b2.captured ~= "" and VALUES[b2.captured:upper()] or 0) * 10 + (b2.promo ~= "" and 900 or 0)) end)
    local mySide = st.side; local anyLegal = false
    for _, m in ipairs(moves) do
        local undo = Engine.Make(st, m)
        if not Engine.IsAttacked(st, findKing(st, mySide), st.side) then
            anyLegal = true
            local score = -search(st, depth - 1, -beta, -alpha, ply + 1)
            Engine.Unmake(st, m, undo)
            if score >= beta then return beta end
            if score > alpha then alpha = score end
        else Engine.Unmake(st, m, undo) end
        if moveCounter > maxNodes then break end
    end
    if not anyLegal then
        if Engine.IsAttacked(st, findKing(st, mySide), enemySide(st.side)) then return -100000 + ply end
        return 0
    end
    return alpha
end

function Engine.BestMove(st, maxDepth, nodeCap)
    maxNodes = nodeCap or 200000; moveCounter = 0
    local rootMoves = Engine.LegalMoves(st)
    if #rootMoves == 0 then return nil end
    if #rootMoves == 1 then return rootMoves[1] end
    table.sort(rootMoves, function(a, b2) return (a.captured ~= "" and VALUES[a.captured:upper()] or 0) * 10 > (b2.captured ~= "" and VALUES[b2.captured:upper()] or 0) * 10 end)
    local best = rootMoves[1]; local bestScore = -1000000
    for depth = 1, maxDepth do
        local localBest, localScore = best, -1000000; local alpha = -1000000
        for _, m in ipairs(rootMoves) do
            local undo = Engine.Make(st, m); local score = -search(st, depth - 1, -1000000, -alpha, 1); Engine.Unmake(st, m, undo)
            if score > localScore then localScore = score; localBest = m end
            if score > alpha then alpha = score end
            if moveCounter > maxNodes then break end
        end
        if moveCounter <= maxNodes then best, bestScore = localBest, localScore end
        if moveCounter > maxNodes then break end
        if math.abs(bestScore) > 90000 then break end
    end
    return best, bestScore
end

local function boardToFen(st)
    local rows = {}
    for r = 0, 7 do
        local row = ""; local empty = 0
        for f = 0, 7 do
            local p = st.b[sq(f, r)]
            if p == "" then empty = empty + 1
            else
                if empty > 0 then row = row .. tostring(empty); empty = 0 end
                row = row .. p
            end
        end
        if empty > 0 then row = row .. tostring(empty) end
        table.insert(rows, row)
    end
    local placement = table.concat(rows, "/")
    local side = st.side or "w"
    local castling = st.castling or "-"; if castling == "" then castling = "-" end
    local ep = "-"
    if st.ep and st.ep >= 0 then ep = string.char(97 + fileOf(st.ep)) .. tostring(8 - rankOf(st.ep)) end
    return placement .. " " .. side .. " " .. castling .. " " .. ep .. " 0 1"
end

