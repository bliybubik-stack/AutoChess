-- ========== MAIN LOOP ==========
task.spawn(function()
    task.wait(1)
    while Bot.running do
        local board = getBoard()
        local s = App and App.session

        if enableHumanMode and not enableAutoPlay and enableShowTimer and isHackRunning and isTimerRunning then
            if timerEndTime > 0 then
                local remaining = timerEndTime - os.clock()
                if remaining > 0 then
                    timerText.Text = string.format("%.1f", remaining)
                    timerText.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    timerText.Text = "MOVE NOW!"
                    timerText.TextColor3 = Color3.fromRGB(255, 50, 50)
                end
            end
        else
            timerFrame.Visible = false
        end

        if isHackRunning and s and board and (s.kind == "online" or s.kind == "bot") then
            if s.over then
                statusLabel.Text = "Status: Game over"
            else
                local ucis = s.ucis or {}
                local ok, myTurn = pcall(function() return s:isMyTurn() end)

                if Bot.awaitingServerUpdate and Bot.awaitingStartTime > 0 and os.clock() - Bot.awaitingStartTime > 3 then
                    Bot.awaitingServerUpdate = false
                end

                if ok and myTurn then
                    if #ucis ~= Bot.lastPly or not Bot.state then
                        Bot.lastPly = #ucis
                        Bot.awaitingServerUpdate = false
                        Bot.awaitingStartTime = 0
                        local lo = math.min(Bot.moveDelayMin, Bot.moveDelayMax)
                        local hi = math.max(Bot.moveDelayMin, Bot.moveDelayMax)
                        Bot.turnDelay = lo + math.random() * (hi - lo)
                        Bot.turnStartTime = os.clock()

                        local st = nil
                        pcall(function() st = stateFromUcis(ucis) end)
                        if not st then
                            local grid = readGrid(board)
                            if grid then
                                local cnt = 0
                                for i = 0, 63 do if grid[i] ~= "" then cnt = cnt + 1 end end
                                if cnt >= 2 then
                                    st = Engine.NewState()
                                    st.b = grid
                                    st.castling = inferCastling(grid)
                                    st.side = Bot.orientation
                                end
                            end
                        end
                        if not st and useVortexFallback and VortexBot and s.startFen then
                            local ok2, vmove = pcall(function()
                                return VortexBot.think(s.startFen, table.clone(ucis), { rating = 1200 }, {})
                            end)
                            if ok2 and type(vmove) == "string" and #vmove >= 4 then
                                local fromAlg = vmove:sub(1, 2)
                                local toAlg = vmove:sub(3, 4)
                                local fromIdx, toIdx
                                if BoardHelper and BoardHelper.algToIndex64 then
                                    fromIdx = BoardHelper.algToIndex64(fromAlg); toIdx = BoardHelper.algToIndex64(toAlg)
                                else
                                    local function alg(i)
                                        local f = string.byte(i, 1) - 97
                                        local r = tonumber(i:sub(2, 2))
                                        return (8 - r) * 8 + f
                                    end
                                    fromIdx = alg(fromAlg); toIdx = alg(toAlg)
                                end
                                if fromIdx and toIdx then
                                    local m = { from = fromIdx, to = toIdx, captured = "", promo = #vmove >= 5 and vmove:sub(5, 5) or "", flags = "" }
                                    lastBestMove = m
                                    statusLabel.Text = string.format("Best: %s%s", fromAlg, toAlg)
                                    if enableHighlight then
                                        if enableHiddenBoard then drawMiniHighlight(m) else drawHighlight(board, m) end
                                    end
                                    if enableAutoPlay then
                                        local promoId = m.promo ~= "" and PROMO_TYPE_ID[m.promo:upper()] or nil
                                        pcall(App.onBoardMove, toGameSquare(m.from), toGameSquare(m.to), promoId)
                                        Bot.awaitingServerUpdate = true
                                        Bot.awaitingStartTime = os.clock()
                                    end
                                end
                            end
                        end
                        if st then
                            Bot.state = st
                            Bot.lastGrid = nil
                            Bot.pending = nil
                            statusLabel.Text = "Status: Synced"
                            isTimerRunning = false
                        else
                            Bot.state = nil
                            statusLabel.Text = "Status: Sync failed"
                        end
                    end

                    if Bot.state then
                        Bot.ourSide = Bot.state.side
                        local alreadyThoughtThisPly = (lastThinkPly == #ucis)
                        local canTrigger = not isCalculating and not isTimerRunning and not Bot.awaitingServerUpdate and not alreadyThoughtThisPly
                        if canTrigger and enableAutoPlay then
                            if os.clock() - Bot.turnStartTime < Bot.turnDelay then canTrigger = false end
                        end

                        if canTrigger then
                            lastThinkPly = #ucis
                            isCalculating = true
                            calculationToken = calculationToken + 1
                            local token = calculationToken
                            statusLabel.Text = "Status: Thinking..."

                            task.spawn(function()
                                local best = nil
                                local fen = boardToFen(Bot.state)
                                if stockfishWorking ~= false then
                                    local sfMove = askStockfish(fen, stockfishDepth, stockfishSkill)
                                    if sfMove then
                                        local legal = Engine.LegalMoves(Bot.state)
                                        local legalMove = nil
                                        for _, lm in ipairs(legal) do
                                            if lm.from == sfMove.from and lm.to == sfMove.to then legalMove = lm; break end
                                        end
                                        if legalMove then
                                            best = legalMove
                                            if sfMove.promo ~= "" then best.promo = sfMove.promo end
                                            stockfishWorking = true
                                            evalLabel.Text = "SF: online ✓"
                                            evalLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
                                        else
                                            stockfishLastError = "SF illegal move"
                                            evalLabel.Text = "SF: illegal → local"
                                            evalLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                                        end
                                    else
                                        if stockfishWorking == nil then
                                            stockfishWorking = false
                                            evalLabel.Text = "SF: offline → local"
                                            evalLabel.TextColor3 = Color3.fromRGB(255, 150, 150)
                                            print("[SF] error: " .. stockfishLastError)
                                        end
                                    end
                                end

                                if not best then
                                    local isSimple = false
                                    local legalMoves = Engine.LegalMoves(Bot.state)
                                    if #legalMoves <= 5 then isSimple = true end
                                    local currentCap = isSimple and math.min(15000, currentNodeCap) or currentNodeCap
                                    local localBest = Engine.BestMove(Bot.state, currentDepth, currentCap)
                                    best = localBest
                                    if best and stockfishWorking ~= true then
                                        evalLabel.Text = "Local engine"
                                        evalLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
                                    end
                                end

                                if token ~= calculationToken or not isHackRunning then
                                    isCalculating = false
                                    return
                                end

                                if best then
                                    lastBestMove = best
                                    local txt = string.format("Best: %s%s", squareName(best.from), squareName(best.to))
                                    statusLabel.Text = "Status: " .. txt
                                    if enableHighlight then
                                        if enableHiddenBoard then drawMiniHighlight(best) else drawHighlight(board, best) end
                                    end
                                    if enableAutoPlay then
                                        local promoId = best.promo ~= "" and PROMO_TYPE_ID[best.promo:upper()] or nil
                                        pcall(App.onBoardMove, toGameSquare(best.from), toGameSquare(best.to), promoId)
                                        Bot.awaitingServerUpdate = true
                                        Bot.awaitingStartTime = os.clock()
                                        Bot.awaitingPly = #ucis + 1
                                    elseif enableHumanMode then
                                        local baseTime = (best._fromSF) and 2.0 or 4.0
                                        local thinkTime = baseTime + (currentDepth * 0.5) + math.random(-5, 5) / 10
                                        if enableShowTimer then
                                            timerEndTime = os.clock() + thinkTime
                                            isTimerRunning = true
                                            timerFrame.Visible = true
                                        end
                                    end
                                end
                                isCalculating = false
                            end)
                        end
                    end
                else
                    if #currentOverlays > 0 and enableHighlight then
                        for _, obj in ipairs(currentOverlays) do obj:Destroy() end
                        currentOverlays = {}
                    end
                    if #miniOverlays > 0 and enableHiddenBoard then
                        for _, obj in ipairs(miniOverlays) do obj:Destroy() end
                        miniOverlays = {}
                    end
                end
            end
        elseif isHackRunning then
            statusLabel.Text = "Status: Waiting for game..."
        else
            statusLabel.Text = "Status: Idle (Hack Off)"
        end
        task.wait(0.05)
    end
end)

