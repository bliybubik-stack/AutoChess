local STOCKFISH_URL = "https://stockfish.online/api/s/v2.php"

local function askStockfish(fen, depth, skill)
    local encodedFen = HttpService:UrlEncode(fen)
    local url = STOCKFISH_URL .. "?fen=" .. encodedFen .. "&depth=" .. tostring(depth or 12)
    if skill then url = url .. "&skill=" .. tostring(skill) end
    local res, err = httpRequest({ Url = url, Method = "GET" })
    if not res then stockfishLastError = "http fail: " .. tostring(err); return nil end
    if res.StatusCode ~= 200 then stockfishLastError = "status " .. tostring(res.StatusCode); return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" then stockfishLastError = "json parse fail"; return nil end
    if data.success == false then stockfishLastError = "api success=false"; return nil end
    local raw = data.bestmove or (data.data and data.data.bestmove)
    if not raw or raw == "" then stockfishLastError = "empty bestmove"; return nil end
    local uci = raw:match("bestmove%s+([a-h][1-8][a-h][1-8]%w?)") or raw:match("^([a-h][1-8][a-h][1-8]%w?)")
    if not uci then stockfishLastError = "cannot parse: " .. raw; return nil end
    local fromF = string.byte(uci, 1) - 97
    local fromR = tonumber(uci:sub(2, 2))
    local toF = string.byte(uci, 3) - 97
    local toR = tonumber(uci:sub(4, 4))
    if not fromF or not fromR or not toF or not toR then stockfishLastError = "coord fail"; return nil end
    local fromIdx = (8 - fromR) * 8 + fromF
    local toIdx = (8 - toR) * 8 + toF
    local promo = ""
    if #uci >= 5 then promo = uci:sub(5, 5) end
    return { from = fromIdx, to = toIdx, promo = promo, flags = "", captured = "" }
end

