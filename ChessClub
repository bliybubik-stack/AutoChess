    local shStroke = Instance.new("UIStroke")
    shStroke.Thickness = 1
    shStroke.Color = COL_BLACK
    shStroke.Transparency = 0.7
    shStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    shStroke.Parent = shadow

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.7, -8, 1, 0)
    lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
