    addUkrainianOutline(btn)

    local shadow = Instance.new("Frame")
    shadow.Size = UDim2.new(1, 0, 0, 5)
    shadow.Position = UDim2.new(0, 0, 1, -6)
    shadow.BackgroundColor3 = COL_SHADOW
