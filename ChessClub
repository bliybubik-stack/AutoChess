-- ========== обводка тексту ==========
local function addTextStroke(label)
    local s = Instance.new("UIStroke")
    s.Thickness = 2.5
    s.Color = COL_BLACK
    s.Transparency = 0.65
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    s.Parent = label
    return s
end

-- ========== український градієнт на обводці ==========
local function addUkrainianOutline(btn)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    local grad = Instance.new("UIGradient")
    grad.Rotation = 90
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, COL_UA_BLUE),
        ColorSequenceKeypoint.new(0.5, COL_UA_BLUE),
        ColorSequenceKeypoint.new(1.0, COL_UA_YELLOW),
    })
    grad.Parent = stroke
    stroke.Parent = btn
end

