-- ========== анімація перемикача ==========
local TWEEN_ON  = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_OFF = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function animateToggle(knob, track, on)
    local targetPos = on and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    local targetColor = on and COL_FG or COL_DIM
    local targetTrack = on and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(10, 10, 10)
    TweenService:Create(knob, on and TWEEN_ON or TWEEN_OFF, {
        Position = targetPos,
        BackgroundColor3 = targetColor,
    }):Play()
    TweenService:Create(track, on and TWEEN_ON or TWEEN_OFF, {
        BackgroundColor3 = targetTrack,
    }):Play()
end

