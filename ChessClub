-- ========== http ==========
local function httpRequest(options)
    local reqFunc = (syn and syn.request)
        or (http and http.request)
        or (fluxus and fluxus.request)
        or (krnl and krnl.request)
        or request
        or http_request
    if not reqFunc then return nil, "нема http в екзекуторі" end
    local ok, res = pcall(reqFunc, options)
    if not ok then return nil, tostring(res) end
    return res
end

-- ========== stockfish api ==========
local STOCKFISH_URL = "https://stockfish.online/api/s/v2.php"

local function getBestMoveFromStockfish(fen, depth)
    depth = depth or 15
    local encodedFen = HttpService:UrlEncode(fen)
    local url = STOCKFISH_URL .. "?fen=" .. encodedFen .. "&depth=" .. tostring(depth)
    local res, err = httpRequest({Url = url, Method = "GET"})
    if not res then return nil, "http зламався: " .. tostring(err) end
    if res.StatusCode ~= 200 then return nil, "статус " .. tostring(res.StatusCode) end
    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or not data then return nil, "json не читається" end
    if data.success == false then return nil, "api каже ні" end
    local move = data.bestmove
    if not move or move == "" then return nil, "api не дав хід" end
    local cleanMove = move:match("bestmove%s+(%S+)") or move:match("^(%S+)")
    if cleanMove and cleanMove ~= "(none)" then return cleanMove end
    return nil, "не можу розібрати хід"
end

