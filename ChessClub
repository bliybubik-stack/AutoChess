local function getGame()
    local g = CPS.ChessGame
    if not g or not g.Active then return nil end
    return g
end

local function isMyTurn(g)
    if not g or g.WhiteToPlay == nil or g.AmIWhite == nil then return false end
    return g.WhiteToPlay == g.AmIWhite
end

local function submitMove(g, move)
    local ev = net and net:FindFirstChild("SubmitMove_" .. tostring(g.GameID))
    if ev and ev:IsA("RemoteEvent") then
        local ok2 = pcall(function() ev:FireServer(move) end)
        if ok2 then return true end
    end
    if g.Remotes and g.Remotes.SubmitMove then
        local r = g.Remotes.SubmitMove
        if r.ClassName == "RemoteEvent" then
            local ok2 = pcall(function() r:FireServer(move) end)
            if ok2 then return true end
        end
    end
    return false
end

-- ========== підказка ==========
local function findSquareFrame(boardGui, square)
    if not boardGui then return nil end
    for _, v in ipairs(boardGui:GetDescendants()) do
        if (v:IsA("Frame") or v:IsA("TextButton") or v:IsA("ImageButton"))
            and (v.Name == square or v.Name == square:upper() or v.Name == square:lower()) then
            return v
        end
    end
    return nil
end

local highlightCache = {}
local function clearHighlights()
    for _, h in ipairs(highlightCache) do
        if h and h.Parent then h:Destroy() end
    end
    highlightCache = {}
end

local function makeHighlight(squareFrame, topColor, bottomColor, addDot)
    if not squareFrame then return end
    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.new(1, 0, 1, 0)
    overlay.Position = UDim2.new(0, 0, 0, 0)
    overlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    overlay.BackgroundTransparency = 0.45
    overlay.BorderSizePixel = 0
    overlay.ZIndex = 10
    overlay.Parent = squareFrame

    local grad = Instance.new("UIGradient")
    grad.Rotation = 90
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, topColor),
        ColorSequenceKeypoint.new(1.0, bottomColor),
    })
    grad.Parent = overlay

    if addDot then
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 10, 0, 10)
        dot.Position = UDim2.new(0.5, -5, 0.5, -5)
        dot.BackgroundColor3 = COL_BLACK
        dot.BackgroundTransparency = 0
        dot.BorderSizePixel = 0
        dot.ZIndex = 11
        dot.Parent = overlay
    end

    table.insert(highlightCache, overlay)
end

local function showSuggestion(move)
    clearHighlights()
    local boardGui = playerGui:FindFirstChild("2DBoard")
    if not boardGui then log("дошка не знайдена, потужно сумно") return end
    local fromSq = string.sub(move, 1, 2)
    local toSq   = string.sub(move, 3, 4)
    local fromFrame = findSquareFrame(boardGui, fromSq)
    local toFrame   = findSquareFrame(boardGui, toSq)

    if fromFrame then
        makeHighlight(fromFrame, Color3.fromRGB(255, 80, 80), COL_START, false)
    end
    if toFrame then
        makeHighlight(toFrame, Color3.fromRGB(255, 190, 90), COL_DEST, true)
    end

    if fromFrame and toFrame then
        log("бери " .. fromSq .. " і йди на " .. toSq .. " потужно")
    else
        log("хід " .. move .. " але клітинки не знайшов")
    end
end

-- ========== цикл ==========
local function autoLoop()
    log("потужний авто включено")
    while autoOn do
        local g = getGame()
        if g then
            local fen = g.FEN
            if fen and isMyTurn(g) and fen ~= lastFen then
                lastFen = fen
                local move, err
                if stockfishWorking ~= false then
                    move, err = getBestMoveFromStockfish(fen, 15)
                    if move then
                        stockfishWorking = true
                        setEngine("stockfish")
                    else
                        log("stockfish зламався: " .. tostring(err))
                        if stockfishWorking == nil then
                            stockfishWorking = false
                            setEngine("sunfish")
                        end
                    end
                end
                if not move then
                    local ok2, sfMove = pcall(function()
                        return sunfish:GetBestMoveFromFEN(fen, 5000)
                    end)
                    if ok2 and sfMove and sfMove ~= "" then
                        move = tostring(sfMove)
                        if stockfishWorking == false then setEngine("sunfish") end
                    end
                end
                if move then
                    if suggestOn then
                        showSuggestion(move)
                    else
                        log("хід: " .. move .. " потужно")
                        if submitMove(g, move) then
                            task.wait(2)
                        else
                            task.wait(2)
                        end
                    end
                else
                    task.wait(2)
                end
            else
                task.wait(0.3)
            end
        else
            task.wait(1)
        end
    end
    log("потужний авто виключено")
end

